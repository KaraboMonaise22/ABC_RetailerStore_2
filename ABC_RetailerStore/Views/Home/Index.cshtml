<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ABC Retail - Home</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        :root {
            --primary-color: #228B22; /* Earth Green */
            --secondary-color: #145214;
            --accent-color: #2E8B57;
            --warning-color: #f4a300;
            --success-color: #3CB371;
            --light-color: #f8f9fa;
            --dark-color: #212529;
            --text-color: #333;
            --border-radius: 12px;
            --shadow: 0 6px 15px rgba(0, 0, 0, 0.08);
            --transition: all 0.3s ease;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            font-style: italic;
            font-weight: bold;
            background: linear-gradient(135deg, #f5f7fb 0%, #e4e8f5 100%);
            color: var(--text-color);
            line-height: 1.6;
            min-height: 100vh;
        }

        .welcome-container {
            background: white;
            border-radius: var(--border-radius);
            padding: 2rem;
            margin-bottom: 2rem;
            box-shadow: var(--shadow);
            text-align: center;
        }

            .welcome-container h2 {
                color: var(--primary-color);
                font-weight: bold;
            }

        /* About Section Cards */
        .about-section {
            margin-top: 2rem;
        }

        .feature-card {
            background: white;
            border-radius: var(--border-radius);
            overflow: hidden;
            box-shadow: var(--shadow);
            transition: var(--transition);
            height: 100%;
            text-align: center;
            border-top: 4px solid transparent;
            padding: 1.5rem;
        }

            .feature-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 12px 20px rgba(0, 0, 0, 0.12);
            }

            .feature-card i {
                font-size: 3rem;
                margin-bottom: 1rem;
            }

        .about-card {
            border-top-color: var(--primary-color);
        }

        .mission-card {
            border-top-color: var(--accent-color);
        }

        .vision-card {
            border-top-color: var(--warning-color);
        }

        .goal-card {
            border-top-color: var(--success-color);
        }

        .about-card i {
            color: var(--primary-color);
        }

        .mission-card i {
            color: var(--accent-color);
        }

        .vision-card i {
            color: var(--warning-color);
        }

        .goal-card i {
            color: var(--success-color);
        }

        .card-title {
            font-size: 1.3rem;
            margin-bottom: 0.75rem;
        }

        .card-text {
            color: #555;
        }
    </style>
</head>
<body>
    <div class="container py-4">

        <!-- Welcome Section -->
        <div class="welcome-container fade-in">
            <h2>Welcome to ABC Retail Store</h2>
            <p>Manage your retail operations efficiently with Azure Storage Services</p>
        </div>

        <!-- About Us Section -->
        <div class="about-section">
            <div class="row g-4">
                <!-- About Us -->
                <div class="col-lg-3 col-md-6">
                    <div class="feature-card about-card fade-in">
                        <i class="fas fa-info-circle"></i>
                        <h5 class="card-title">About Us</h5>
                        <p class="card-text">We are dedicated to providing innovative retail solutions powered by Azure services.</p>
                    </div>
                </div>
                <!-- Mission -->
                <div class="col-lg-3 col-md-6">
                    <div class="feature-card mission-card fade-in">
                        <i class="fas fa-bullseye"></i>
                        <h5 class="card-title">Mission</h5>
                        <p class="card-text">To deliver seamless and efficient retail management systems that empower businesses.</p>
                    </div>
                </div>
                <!-- Vision -->
                <div class="col-lg-3 col-md-6">
                    <div class="feature-card vision-card fade-in">
                        <i class="fas fa-eye"></i>
                        <h5 class="card-title">Vision</h5>
                        <p class="card-text">To become a leading provider of cloud-driven retail solutions worldwide.</p>
                    </div>
                </div>
                <!-- Goal -->
                <div class="col-lg-3 col-md-6">
                    <div class="feature-card goal-card fade-in">
                        <i class="fas fa-flag-checkered"></i>
                        <h5 class="card-title">Goal</h5>
                        <p class="card-text">To continuously innovate and enhance customer satisfaction through technology.</p>
                    </div>
                </div>
            </div>
        </div>

    </div>
</body>
</html>
