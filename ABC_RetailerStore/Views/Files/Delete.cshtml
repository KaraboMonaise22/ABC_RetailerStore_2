

@{
    ViewData["Title"] = "Delete File";
    var fileName = ViewBag.FileName as string;
}

<h1>Delete File</h1>

<div class="alert alert-warning">
    <h4>Are you sure you want to delete this file?</h4>
    <p>This action cannot be undone.</p>
</div>

<div class="row">
    <div class="col-md-6">
        <dl class="row">
            <dt class="col-sm-4">File Name:</dt>
            <dd class="col-sm-8">@fileName</dd>

            <dt class="col-sm-4">File Type:</dt>
           
        </dl>
    </div>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" name="fileName" value="@fileName" />
    <button type="submit" class="btn btn-danger">Delete File</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
