@{
    ViewData["Title"] = "File Details";
    var fileName = ViewBag.FileName as string;
    
}

<h1>File Details</h1>

<div class="row">
    <div class="col-md-6">
        <dl class="row">
            <dt class="col-sm-4">File Name:</dt>
            <dd class="col-sm-8">@fileName</dd>
            
            <dt class="col-sm-4">File Type:</dt>
           @*  <dd class="col-sm-8">@Path.GetExtension(fileName)</dd> *@
            
            <dt class="col-sm-4">Storage Location:</dt>
            <dd class="col-sm-8">Azure File Storage</dd>
        </dl>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Download" asp-route-fileName="@fileName" class="btn btn-success">Download</a>
    <a asp-action="Edit" asp-route-fileName="@fileName" class="btn btn-primary">Rename</a>
    <a asp-action="Delete" asp-route-fileName="@fileName" class="btn btn-danger">Delete</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>
