@model IEnumerable<string>

@{
    ViewData["Title"] = "Order Processing";
}



<nav aria-label="breadcrumb">
    <ol class="breadcrumb breadcrumb-modern">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Orders</a></li>
        <li class="breadcrumb-item active" aria-current="page">Create</li>
    </ol>
</nav>


<div class="page-header">
    <h1 class="page-title">
        <i class="fas fa-users me-3"></i>>Order Processing 
    </h1>
    <a asp-action="Create" class="btn-modern-primary">
        Create New Order
    </a>
</div>
<div class="modern-card">
    <div class="table-responsive">







        <div class="row" justify-content-center>
    <div class="col-md-12">
        <h3>Recent Order Messages</h3>
        @if (Model.Any())
        {
            <div class="list-group">
                @foreach (var message in Model.Select((msg, index) => new { Message = msg, Index = index }))
                {
                    <div class="list-group-item d-flex justify-content-between align-items-start">
                        <div class="flex-grow-1">
                            <pre>@message.Message</pre>
                        </div>
                        <div class="action-buttons">
                                    <a asp-action="Details" asp-route-id="order-@message.Index" class="btn-modern-secondary" title="View Details">
                                    <i class="fas fa-eye"></i>
                                </a>
                                    <a asp-action="Edit" asp-route-id="order-@message.Index" class="btn-modern-secondary" title="Edit">
                                    <i class="fas fa-edit"></i>
                                </a>
                                    <a asp-action="Delete" asp-route-id="order-@message.Index" class="btn-modern-danger" title="Delete">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </div>
                    </div>
                }
            </div>
        }
        else
        {
            <p>No order messages in queue.</p>
        }
    </div>
</div>
</div></div>