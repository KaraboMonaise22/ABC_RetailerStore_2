@model ABCRetail.Web.Models.OrderMessage

@{
    ViewData["Title"] = "Delete Order";
}

<h1>Delete Order</h1>

<div class="alert alert-warning">
    <h4>Are you sure you want to delete this order?</h4>
    <p>This action cannot be undone.</p>
</div>

<div class="row">
    <div class="col-md-6">
        <dl class="row">
            <dt class="col-sm-4">Order ID:</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.OrderId)</dd>
            
            <dt class="col-sm-4">Customer ID:</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.CustomerId)</dd>
            
            <dt class="col-sm-4">Product ID:</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.ProductId)</dd>
            
            <dt class="col-sm-4">Quantity:</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.Quantity)</dd>
            
            <dt class="col-sm-4">Total Amount:</dt>
            <dd class="col-sm-8">$@Html.DisplayFor(model => model.TotalAmount)</dd>
            
            <dt class="col-sm-4">Status:</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.Status)</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="OrderId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
