@model ABCRetail.Web.Models.OrderMessage

@{
    ViewData["Title"] = "Order Details";
}

<h1>Order Details</h1>

<div class="row">
    <div class="col-md-6">
        <dl class="row">
            <dt class="col-sm-4">Order ID:</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.OrderId)</dd>
            
            <dt class="col-sm-4">Customer ID:</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.CustomerId)</dd>
            
            <dt class="col-sm-4">Product ID:</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.ProductId)</dd>
            
            <dt class="col-sm-4">Quantity:</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.Quantity)</dd>
            
            <dt class="col-sm-4">Total Amount:</dt>
            <dd class="col-sm-8">$@Html.DisplayFor(model => model.TotalAmount)</dd>
            
            <dt class="col-sm-4">Status:</dt>
            <dd class="col-sm-8">
                <span class="badge @(Model.Status == "Processing" ? "bg-warning" : Model.Status == "Shipped" ? "bg-info" : Model.Status == "Delivered" ? "bg-success" : "bg-danger")">
                    @Html.DisplayFor(model => model.Status)
                </span>
            </dd>
            
            <dt class="col-sm-4">Created Date:</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.CreatedDate)</dd>
        </dl>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.OrderId" class="btn btn-primary">Edit</a>
    <a asp-action="Delete" asp-route-id="@Model.OrderId" class="btn btn-danger">Delete</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>
