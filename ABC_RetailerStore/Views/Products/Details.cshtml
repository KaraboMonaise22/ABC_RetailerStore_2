@model ABCRetail.Web.Models.Product

@{
    ViewData["Title"] = "Product Details";
}

<h1>Product Details</h1>

<div class="row">
    <div class="col-md-6">
        <dl class="row">
            <dt class="col-sm-4">Name:</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.Name)</dd>
            
            <dt class="col-sm-4">Description:</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.Description)</dd>
            
            <dt class="col-sm-4">Price:</dt>
            <dd class="col-sm-8">$@Html.DisplayFor(model => model.Price)</dd>
            
            <dt class="col-sm-4">Stock Quantity:</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.StockQuantity)</dd>
            
            <dt class="col-sm-4">Category:</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.Category)</dd>
            
            <dt class="col-sm-4">Created Date:</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.CreatedDate)</dd>
        </dl>
    </div>
    <div class="col-md-6">
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <div class="text-center">
                <img src="@Model.ImageUrl" alt="@Model.Name" class="img-fluid" style="max-width: 300px; max-height: 300px; object-fit: cover;" />
            </div>
        }
    </div>
</div>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.RowKey" class="btn btn-primary">Edit</a>
    <a asp-action="Delete" asp-route-id="@Model.RowKey" class="btn btn-danger">Delete</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>
