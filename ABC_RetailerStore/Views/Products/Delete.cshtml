@model ABCRetail.Web.Models.Product

@{
    ViewData["Title"] = "Delete Product";
}

<h1>Delete Product</h1>

<div class="alert alert-warning">
    <h4>Are you sure you want to delete this product?</h4>
    <p>This action cannot be undone.</p>
</div>

<div class="row">
    <div class="col-md-6">
        <dl class="row">
            <dt class="col-sm-4">Name:</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.Name)</dd>
            
            <dt class="col-sm-4">Description:</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.Description)</dd>
            
            <dt class="col-sm-4">Price:</dt>
            <dd class="col-sm-8">$@Html.DisplayFor(model => model.Price)</dd>
            
            <dt class="col-sm-4">Stock Quantity:</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.StockQuantity)</dd>
            
            <dt class="col-sm-4">Category:</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.Category)</dd>
        </dl>
    </div>
    <div class="col-md-6">
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <div class="text-center">
                <img src="@Model.ImageUrl" alt="@Model.Name" class="img-fluid" style="max-width: 200px; max-height: 200px; object-fit: cover;" />
            </div>
        }
    </div>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="RowKey" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
